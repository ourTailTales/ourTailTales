## ourTailTales configuration
# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_APP_NAME=ourTailTales
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## Supabase — leads, orders, shipping, and the two temporary print PDFs.
# The service-role key is server-only and must never reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ourtailtales-orders

## AI — chapter titles and blurbs. Server-side only; never exposed to the browser.
# AI_PROVIDER selects the implementation in src/lib/ai. Supported: gemini.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=

## Reverse geocoding — city/region/country from reduced-precision centroids.
# Defaults to Nominatim, which needs no key. Override to use another provider.
GEOCODE_URL=
GEOCODE_API_KEY=

## Stripe — PaymentIntent + Payment Element. The webhook is the only path to print.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

## Lulu Print API — server-side only.
# LULU_POD_PACKAGE_ID is the dotted id for the 8.5x8.5 hardcover; confirm it in
# the Lulu price calculator (FC / PRE / casewrap / 80# coated white / matte).
LULU_ENV=sandbox
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_POD_PACKAGE_ID=
LULU_CONTACT_EMAIL=
LULU_WEBHOOK_SECRET=

## Daily cleanup of print PDFs older than 7 days.
CRON_SECRET=
