## ourTailTales — copy to .env.local. Never commit real values.

## Site
# Set this ONLY for local development and for the Production environment in
# Vercel. Leave it UNSET in Preview: src/lib/env.ts then falls back to
# VERCEL_BRANCH_URL, so each preview's emails and Stripe redirects point at
# that preview rather than at production.
#
# Production is https://www.ourtailtales.com — the apex 308-redirects to www,
# so the www form is canonical and avoids a redirect hop on every emailed book
# link and Stripe return URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
## Defaults to ourtailtales-orders. Private bucket file_size_limit must be ≥ VIDEO_MEMORY_MAX_SOURCE_BYTES.
SUPABASE_STORAGE_BUCKET=

## AI
GEMINI_API_KEY=
## Defaults to gemini. Adding another provider means a new module, not a UI change.
AI_PROVIDER=
## Defaults to gemini-flash-lite-latest, with minimal thinking and low image resolution (see src/lib/ai/gemini.ts). Set a Flash model here for more polished copy at higher cost.
AI_MODEL=

## Geocode — chapter place labels from reduced-precision centroids only.
## Defaults to Nominatim. Optional API key if the provider requires one.
GEOCODE_URL=
GEOCODE_API_KEY=

## Stripe
# Stripe. TEST keys locally and in preview; LIVE keys in production only.
#
# The switch is configuration, not code: Vercel scopes each variable per
# environment, so all three names below hold the test pair under
# Environment = Preview + Development, and the live pair under Production.
# Nothing in the app branches on the environment to pick a key — src/lib/stripe.ts
# only *verifies* the pair matches where it is running, and throws if a live key
# turns up outside production.
#
# This file is the local copy, so it always holds TEST values.
#
# Each mode needs its own webhook endpoint and therefore its own signing secret:
#   test → https://dashboard.stripe.com/test/webhooks
#   live → https://dashboard.stripe.com/webhooks
# Both point at <site>/api/stripe/webhook and subscribe to
# these five events, which are every event the handler acts on:
#   checkout.session.completed, payment_intent.succeeded,
#   payment_intent.payment_failed, charge.refunded, charge.dispute.created
# Without the last two, a refunded or disputed order still goes to print.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

## US sales tax, through Stripe Tax. Off unless this is "true".
## Before turning it on: activate Stripe Tax in the dashboard (origin address),
## and add a registration for each state you are registered to collect in.
## Stripe adds tax only for those states, so with no registrations it adds none.
## Stripe bills for Tax per transaction. Requires the migration
## supabase/migrations/20261006090000_order_sales_tax.sql.
STRIPE_TAX_ENABLED=false
## Product tax codes. These are the defaults; set them only to change them.
## Hardcover: general tangible goods. PDF: digital book, downloaded, permanent.
STRIPE_TAX_CODE_HARDCOVER=txcd_99999999
STRIPE_TAX_CODE_DIGITAL=txcd_10302000

## Lulu — sandbox for local/dev and Preview; production only after Auto Pay +
## a physical sample. Sandbox and production are SEPARATE Lulu accounts with
## separate credentials, so LULU_CLIENT_KEY/SECRET differ per environment and
## each environment needs its own webhook registration. The webhook HMAC uses
## the owning environment's LULU_CLIENT_SECRET unless LULU_WEBHOOK_SECRET is set.
##
## Until LULU_ENV=production, a LIVE Stripe key makes `fulfilmentModeMismatch()`
## true and paid hardcover orders are parked as `needs_review` rather than sent
## to the sandbox. Digital books are unaffected.
LULU_ENV=sandbox
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_POD_PACKAGE_ID=0850X0850.FC.PRE.CW.080CW444.MXX
LULU_CONTACT_EMAIL=
LULU_WEBHOOK_SECRET=

## Cron — generate with: openssl rand -hex 32
CRON_SECRET=

## Video Memories master switch. Server-side only. The feature is OFF unless this
## is exactly "true": no Videos tab, no landing copy, and /api/videos/**,
## /api/placements/** and /api/orders/freeze answer 404. Leave it off until the
## processing and archival keys below are set. Changing it needs a redeploy.
VIDEO_MEMORIES_ENABLED=false
## Video Memories — operational only. Packs and the 40 MB processed cap are code constants.
## Keep this at or below the private bucket file_size_limit (migration 0003 sets 1 GB).
VIDEO_MEMORY_MAX_SOURCE_BYTES=524288000
## Abuse/load safeguard only. Never shown as a product maximum and never used in pack math.
VIDEO_MEMORY_OPERATIONAL_MAX_ASSETS_PER_DRAFT=40
## 32-byte hex key used to wrap per-video AES keys at rest. Generate with: openssl rand -hex 32
VIDEO_MEMORY_WRAP_KEY=
## Turbo / Arweave — used only after successful payment. Never shown to customers.
TURBO_PAYMENT_KEY=
ARWEAVE_JWK=
ARWEAVE_PLAYER_TX=

# Email (Resend). Unset is safe: senders log and no-op instead of failing.
RESEND_API_KEY=
# Defaults to "ourTailTales <onboarding@resend.dev>", which is Resend's shared
# onboarding domain: it only delivers to the Resend account owner and drops
# everything else silently, reporting "delivered" either way.
#
# Set to an address on ourtailtales.com once that domain shows Verified in
# Resend. Click tracking stays OFF for this domain: it rewrites every link in
# the body through the tracking subdomain, which would route the book link's
# ?k=<secret> through a third-party redirect and into Resend's click logs —
# the same secret src/lib/analytics-redact.ts exists to keep out of analytics.
EMAIL_FROM=ourTailTales <hello@ourtailtales.com>

## PostHog — required locally: getPostHogClient() throws when either is missing
## and NODE_ENV is development, so a silent analytics gap fails loudly instead.
## Both are NEXT_PUBLIC_ and therefore inlined at build time: changing them in
## Vercel does nothing until the next deploy.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

## Operations
## Where stuck or mismatched paid orders are emailed (src/lib/ops/alert.ts).
## Unset, every alert is a log line only.
OPS_ALERT_EMAIL=
## Signs the order links. Optional: falls back to the Supabase service key.
## Generate with: openssl rand -hex 32. Changing it breaks open checkout links.
ORDER_TOKEN_SECRET=
