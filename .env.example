## ourTailTales — copy to .env.local. Never commit real values.

## Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
## Defaults to ourtailtales-orders. Private bucket file_size_limit must be ≥ VIDEO_MEMORY_MAX_SOURCE_BYTES.
SUPABASE_STORAGE_BUCKET=

## AI
GEMINI_API_KEY=
## Defaults to gemini. Adding another provider means a new module, not a UI change.
AI_PROVIDER=
## Defaults to gemini-3.1-flash-lite.
AI_MODEL=

## Geocode — chapter place labels from reduced-precision centroids only.
## Defaults to Nominatim. Optional API key if the provider requires one.
GEOCODE_URL=
GEOCODE_API_KEY=

## Stripe
# Stripe. TEST keys locally and in preview; LIVE keys in production only.
#
# The switch is configuration, not code: Vercel scopes each variable per
# environment, so all three names below hold the test pair under
# Environment = Preview + Development, and the live pair under Production.
# Nothing in the app branches on the environment to pick a key — src/lib/stripe.ts
# only *verifies* the pair matches where it is running, and throws if a live key
# turns up outside production.
#
# This file is the local copy, so it always holds TEST values.
#
# Each mode needs its own webhook endpoint and therefore its own signing secret:
#   test → https://dashboard.stripe.com/test/webhooks
#   live → https://dashboard.stripe.com/webhooks
# Both point at <site>/api/stripe/webhook and subscribe to
# checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

## Lulu — sandbox for local/dev; production only after Auto Pay + physical sample
LULU_ENV=sandbox
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_POD_PACKAGE_ID=0850X0850.FC.PRE.CW.080CW444.MXX
LULU_CONTACT_EMAIL=myphungquoc@gmail.com
LULU_WEBHOOK_SECRET=

## Cron — generate with: openssl rand -hex 32
CRON_SECRET=

## Video Memories — operational only. Packs and the 40 MB processed cap are code constants.
## Keep this at or below the private bucket file_size_limit (migration 0003 sets 1 GB).
VIDEO_MEMORY_MAX_SOURCE_BYTES=524288000
## Abuse/load safeguard only. Never shown as a product maximum and never used in pack math.
VIDEO_MEMORY_OPERATIONAL_MAX_ASSETS_PER_DRAFT=10000
## 32-byte hex key used to wrap per-video AES keys at rest. Generate with: openssl rand -hex 32
VIDEO_MEMORY_WRAP_KEY=
## Turbo / Arweave — used only after successful payment. Never shown to customers.
TURBO_PAYMENT_KEY=
ARWEAVE_JWK=
ARWEAVE_PLAYER_TX=

# Email (Resend). Unset is safe: senders log and no-op instead of failing.
RESEND_API_KEY=
# Optional. Defaults to "ourTailTales <onboarding@resend.dev>".
EMAIL_FROM=
